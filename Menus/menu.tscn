[sub_resource type="GDScript" id="GDScript_5cvnc"]
script/source = "extends Control
@onready var animation_player = $FadeLayer/AnimationPlayer

func _ready():
	MenuMusic.play_music_menu()


func _on_play_pressed():
	animation_player.play(\"Transition_out\")
	await animation_player.animation_finished
	get_tree().change_scene_to_file(\"res://Levels/Final_Level_1_Castlev2PSD_Night.tscn\")



func _on_options_pressed():
	get_tree().change_scene_to_file(\"res://Menus/options_menu.tscn\")


func _on_quit_pressed():
	#get_tree().root.propagate_notification(NOTIFICATION_WM_CLOSE_REQUEST)
	get_tree().quit()

"

